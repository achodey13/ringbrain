# --- LLM ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Database ---
DATABASE_URL=postgresql+psycopg2://ringbrain:ringbrain@localhost:5432/ringbrain

# --- Twilio (voice + SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google Calendar ---
# Path to an OAuth client-secret JSON downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Desktop app).
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/google_calendar_client_secret.json
GOOGLE_CALENDAR_TOKEN_PATH=./credentials/google_calendar_token.json
GOOGLE_CALENDAR_ID=primary

# --- Business config ---
BUSINESS_NAME=Sunrise Dental
BUSINESS_TIMEZONE=America/New_York
